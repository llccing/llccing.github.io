---
export interface Props {
  noPadding?: boolean;
  ariaHidden?: boolean;
}

const { noPadding = false, ariaHidden = true } = Astro.props;
---

<div class="hr-wrap" data-no-padding={noPadding}>
  <hr aria-hidden={ariaHidden} />
</div>

<style>
  .hr-wrap {
    width: 100%;
    max-width: var(--measure-wide);
    margin: 0 auto;
    padding-inline: var(--gutter);
  }

  .hr-wrap[data-no-padding="true"] {
    padding-inline: 0;
  }

  hr {
    margin: 0;
    border: 0;
    border-top: var(--hairline);
  }
</style>
