---
export interface Props {
  tag: string;
  size?: "sm" | "lg";
}

const { tag, size = "sm" } = Astro.props;
---

<li class="tag-item">
  <a
    href={`/tags/${tag}/`}
    transition:name={tag}
    class={`tag-link ${size === "lg" ? "tag-link--lg" : ""}`}
  >
    <span class="tag-link__label">{tag}</span>
  </a>
</li>

<style>
  .tag-item {
    display: inline-block;
  }

  .tag-link {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.2rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: var(--r-control);
    background: transparent;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--step-meta);
    font-weight: 600;
    text-decoration: none;
    transition:
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }

  .tag-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .tag-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .tag-link--lg {
    min-height: 2.5rem;
    padding: 0.4rem 1rem;
    font-size: var(--step-body);
  }

  .tag-link__label::before {
    content: "#";
    margin-right: 0.15em;
    color: var(--accent);
  }
</style>
