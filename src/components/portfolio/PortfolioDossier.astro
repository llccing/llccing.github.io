---
/*
  「纸 × 朱批」简历变体 · 与博客同源令牌
  数据来源：src/data/portfolio.resume.json（en 顶层 + zh 子树）
  语言切换：服务端把两份文案都写进 DOM，客户端内联脚本切换，无需 hydration
*/
import resume from "@data/portfolio.resume.json";

const enProfile = resume.profile;
const zhProfile = resume.zh.profile;

const CITY_ZH: Record<string, string> = {
  Shanghai: "上海",
  Dalian: "大连",
  Beijing: "北京",
};

const splitCompany = (value: string) => {
  const [en, zh] = value.split(" / ");
  return { en, zh: zh ?? en };
};

const zhPeriod = (period: string) => period.replace("Present", "至今");

const jobs = resume.experiences.map((exp, i) => {
  const zh = resume.zh.experiences.find(item => item.id === exp.id);
  return {
    id: exp.id,
    company: splitCompany(exp.company),
    period: { en: exp.period, zh: zhPeriod(exp.period) },
    city: { en: exp.location, zh: CITY_ZH[exp.location] ?? exp.location },
    role: { en: exp.role, zh: zh?.role ?? exp.role },
    summary: { en: exp.summary, zh: zh?.summary ?? exp.summary },
    details: exp.details.map((detail, k) => ({
      en: detail,
      zh: zh?.details[k] ?? detail,
    })),
    tech: exp.tech,
    idx: i,
  };
});

const systems = resume.featuredSystems.map((system, i) => ({
  name: {
    en: system.name,
    zh: resume.zh.featuredSystems[i]?.name ?? system.name,
  },
  summary: {
    en: system.summary,
    zh: resume.zh.featuredSystems[i]?.summary ?? system.summary,
  },
  tags: system.tags,
}));

const metrics = resume.metrics.map((metric, i) => ({
  value: { en: metric.value, zh: resume.zh.metrics[i]?.value ?? metric.value },
  label: { en: metric.label, zh: resume.zh.metrics[i]?.label ?? metric.label },
}));

const skillGroups = [
  {
    title: { zh: "核心前端", en: "Core front-end" },
    en: resume.skills.frontend,
    zh: resume.zh.skills.frontend,
  },
  {
    title: { zh: "系统与后端", en: "Systems & back end" },
    en: resume.skills.fullstack,
    zh: resume.zh.skills.fullstack,
  },
  {
    title: { zh: "工程与 AI", en: "Engineering & AI" },
    en: resume.skills.engineeringAndAi,
    zh: resume.zh.skills.engineeringAndAi,
  },
  {
    title: { zh: "协作与流程", en: "Workflow" },
    en: resume.skills.learningAndCollaboration,
    zh: resume.zh.skills.learningAndCollaboration,
  },
].map(group => ({
  title: group.title,
  items: group.en.map((item, k) => ({ en: item, zh: group.zh[k] ?? item })),
}));

const ui = {
  eyebrow: { zh: "简历 / 作品集", en: "Resume / Portfolio" },
  draft: { zh: "草稿 · 未公开", en: "Draft · not public" },
  targetRole: {
    zh: `目标岗位：${zhProfile.targetRole}`,
    en: `Target role: ${enProfile.targetRole}`,
  },
  lede: { zh: zhProfile.summary, en: enProfile.summary },
  metricsTitle: { zh: "关键数字", en: "By the numbers" },
  systemsTitle: { zh: "精选系统", en: "Featured systems" },
  systemsNote: {
    zh: "五个真正交付过的系统，按「规模与架构 / 技术领导力 / 设计还原度」三个维度挑，避免全部堆架构故事。",
    en: "Five shipped systems, selected across three dimensions — scale & architecture, technical leadership, and design fidelity — instead of repeating one story five times.",
  },
  careerTitle: { zh: "职业历程", en: "Career" },
  careerNote: {
    zh: "结果优先：每段先给一句影响，技术细节折叠在「查看细节」里，读者可以自己决定读多深。",
    en: "Impact first: one line of outcome per role, with technical detail folded behind “Details” so readers choose their own depth.",
  },
  skillsTitle: { zh: "能力构成", en: "Capabilities" },
  factsTitle: {
    zh: "学历 · 认证 · 语言",
    en: "Education · Certification · Languages",
  },
  details: { zh: "查看细节", en: "Details" },
  stack: { zh: "技术栈", en: "Stack" },
  unlisted: {
    zh: "本页暂未加入导航，仅通过链接访问。",
    en: "Not linked from the site navigation; reachable by URL only.",
  },
  backHome: { zh: "← 返回 rowanliu.com", en: "← Back to rowanliu.com" },
};

const facts = [
  {
    title: { zh: "学历", en: "Education" },
    body: { zh: zhProfile.education, en: enProfile.education },
  },
  {
    title: { zh: "认证", en: "Certification" },
    body: {
      zh: "AWS Certified Solutions Architect – Associate（AWS SAA）",
      en: "AWS Certified Solutions Architect – Associate (AWS SAA)",
    },
  },
  {
    title: { zh: "语言", en: "Languages" },
    body: {
      zh: "中文母语 · 英语 CET-4，可作为工作语言",
      en: "Chinese: native · English: CET-4, usable as a working language",
    },
  },
];

const names = { zh: enProfile.chineseName, en: enProfile.name };
const phone = enProfile.phone.replace(/^(\d{3})(\d{4})(\d{4})$/, "$1 $2 $3");
const pad = (n: number) => String(n).padStart(2, "0");
---

<div class="dossier">
  <div class="topbar">
    <div class="wrap topbar-inner">
      <div class="topbar-id">
        <span data-zh={names.zh} data-en={names.en}>{names.zh}</span>
        <span class="topbar-id__alt" data-zh={names.en} data-en={names.zh}
          >{names.en}</span
        >
      </div>
      <div class="tools">
        <span class="draft-chip" data-zh={ui.draft.zh} data-en={ui.draft.en}
          >{ui.draft.zh}</span
        >
        <button id="lang-btn" class="btn" type="button" aria-pressed="false">
          EN
        </button>
        <button
          id="theme-btn"
          class="btn btn--icon"
          type="button"
          aria-label="auto"
          title="Toggles light & dark"
        >
          <svg xmlns="http://www.w3.org/2000/svg" id="moon-svg">
            <path
              d="M20.742 13.045a8.088 8.088 0 0 1-2.077.271c-2.135 0-4.14-.83-5.646-2.336a8.025 8.025 0 0 1-2.064-7.723A1 1 0 0 0 9.73 2.034a10.014 10.014 0 0 0-4.489 2.582c-3.898 3.898-3.898 10.243 0 14.143a9.937 9.937 0 0 0 7.072 2.93 9.93 9.93 0 0 0 7.07-2.929 10.007 10.007 0 0 0 2.583-4.491 1.001 1.001 0 0 0-1.224-1.224zm-2.772 4.301a7.947 7.947 0 0 1-5.656 2.343 7.953 7.953 0 0 1-5.658-2.344c-3.118-3.119-3.118-8.195 0-11.314a7.923 7.923 0 0 1 2.06-1.483 10.027 10.027 0 0 0 2.89 7.848 9.972 9.972 0 0 0 7.848 2.891 8.036 8.036 0 0 1-1.484 2.059z"
            ></path>
          </svg>
          <svg xmlns="http://www.w3.org/2000/svg" id="sun-svg">
            <path
              d="M6.993 12c0 2.761 2.246 5.007 5.007 5.007s5.007-2.246 5.007-5.007S14.761 6.993 12 6.993 6.993 9.239 6.993 12zM12 8.993c1.658 0 3.007 1.349 3.007 3.007S13.658 15.007 12 15.007 8.993 13.658 8.993 12 10.342 8.993 12 8.993zM10.998 19h2v3h-2zm0-17h2v3h-2zm-9 9h3v2h-3zm17 0h3v2h-3zM4.219 18.363l2.12-2.122 1.415 1.414-2.12 2.122zM16.24 6.344l2.122-2.122 1.414 1.414-2.122 2.122zM6.342 7.759 4.22 5.637l1.415-1.414 2.12 2.122zm13.434 10.605-1.414 1.414-2.122-2.122 1.414-1.414z"
            ></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <header class="hero wrap">
    <p class="eyebrow" data-zh={ui.eyebrow.zh} data-en={ui.eyebrow.en}>
      {ui.eyebrow.zh}
    </p>
    <div class="hero-split">
      <div>
        <h1 class="hero-name">
          <span data-zh={names.zh} data-en={names.en}>{names.zh}</span>
          <small data-zh={names.en} data-en={names.zh}>{names.en}</small>
        </h1>
        <p
          class="role-line"
          data-zh={ui.targetRole.zh}
          data-en={ui.targetRole.en}
        >
          {ui.targetRole.zh}
        </p>
        <p class="lede" data-zh={ui.lede.zh} data-en={ui.lede.en}>
          {ui.lede.zh}
        </p>
      </div>
      <div class="contact">
        <span class="mono" data-zh="上海 · 中国" data-en={enProfile.location}
          >上海 · 中国</span
        >
        <a class="mono" href={`mailto:${enProfile.email}`}>{enProfile.email}</a>
        <span class="mono">{phone}</span>
        <a class="mono" href={enProfile.website}>rowanliu.com</a>
      </div>
    </div>
  </header>

  <main class="wrap">
    <section class="section" aria-labelledby="dossier-metrics">
      <div class="subhead">
        <h2
          id="dossier-metrics"
          data-zh={ui.metricsTitle.zh}
          data-en={ui.metricsTitle.en}
        >
          {ui.metricsTitle.zh}
        </h2>
        <span class="count mono">{pad(metrics.length)}</span>
      </div>
      <div class="metrics">
        {
          metrics.map(metric => (
            <div class="metric">
              <b
                class="mono"
                data-zh={metric.value.zh}
                data-en={metric.value.en}
              >
                {metric.value.zh}
              </b>
              <span data-zh={metric.label.zh} data-en={metric.label.en}>
                {metric.label.zh}
              </span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section" aria-labelledby="dossier-systems">
      <div class="subhead">
        <h2
          id="dossier-systems"
          data-zh={ui.systemsTitle.zh}
          data-en={ui.systemsTitle.en}
        >
          {ui.systemsTitle.zh}
        </h2>
        <span class="count mono">{pad(systems.length)}</span>
      </div>
      <p
        class="subnote"
        data-zh={ui.systemsNote.zh}
        data-en={ui.systemsNote.en}
      >
        {ui.systemsNote.zh}
      </p>
      <div class="systems">
        {
          systems.map((system, i) => (
            <article class="sys">
              <p class="sys-no mono">No.{pad(i + 1)}</p>
              <h3 data-zh={system.name.zh} data-en={system.name.en}>
                {system.name.zh}
              </h3>
              <p data-zh={system.summary.zh} data-en={system.summary.en}>
                {system.summary.zh}
              </p>
              <ul class="chips">
                {system.tags.map(tag => (
                  <li class="chip">{tag}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section" aria-labelledby="dossier-career">
      <div class="subhead">
        <h2
          id="dossier-career"
          data-zh={ui.careerTitle.zh}
          data-en={ui.careerTitle.en}
        >
          {ui.careerTitle.zh}
        </h2>
        <span class="count mono">{pad(jobs.length)}</span>
      </div>
      <p class="subnote" data-zh={ui.careerNote.zh} data-en={ui.careerNote.en}>
        {ui.careerNote.zh}
      </p>
      <div class="timeline">
        {
          jobs.map(job => (
            <article class="job">
              <div class="job-head">
                <div class="job-period mono">
                  <span data-zh={job.period.zh} data-en={job.period.en}>
                    {job.period.zh}
                  </span>
                  <br />
                  <span data-zh={job.city.zh} data-en={job.city.en}>
                    {job.city.zh}
                  </span>
                </div>
                <div>
                  <h3
                    class="job-company"
                    data-zh={job.company.zh}
                    data-en={job.company.en}
                  >
                    {job.company.zh}
                  </h3>
                  <p
                    class="job-role"
                    data-zh={job.role.zh}
                    data-en={job.role.en}
                  >
                    {job.role.zh}
                  </p>
                  <p
                    class="job-summary"
                    data-zh={job.summary.zh}
                    data-en={job.summary.en}
                  >
                    {job.summary.zh}
                  </p>
                  <details open={job.idx === 0}>
                    <summary data-zh={ui.details.zh} data-en={ui.details.en}>
                      {ui.details.zh}
                    </summary>
                    <ul class="job-details">
                      {job.details.map(detail => (
                        <li data-zh={detail.zh} data-en={detail.en}>
                          {detail.zh}
                        </li>
                      ))}
                    </ul>
                  </details>
                  <ul class="chips" aria-label={ui.stack.zh}>
                    {job.tech.map(tech => (
                      <li class="chip">{tech}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section" aria-labelledby="dossier-skills">
      <div class="subhead">
        <h2
          id="dossier-skills"
          data-zh={ui.skillsTitle.zh}
          data-en={ui.skillsTitle.en}
        >
          {ui.skillsTitle.zh}
        </h2>
        <span class="count mono">{pad(skillGroups.length)}</span>
      </div>
      <div class="skills">
        {
          skillGroups.map(group => (
            <div class="skill-group">
              <h3 data-zh={group.title.zh} data-en={group.title.en}>
                {group.title.zh}
              </h3>
              <ul class="chips">
                {group.items.map(item => (
                  <li class="chip" data-zh={item.zh} data-en={item.en}>
                    {item.zh}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section" aria-labelledby="dossier-facts">
      <div class="subhead">
        <h2
          id="dossier-facts"
          data-zh={ui.factsTitle.zh}
          data-en={ui.factsTitle.en}
        >
          {ui.factsTitle.zh}
        </h2>
        <span class="count mono">{pad(facts.length)}</span>
      </div>
      <div class="facts">
        {
          facts.map(fact => (
            <div class="fact">
              <h3 data-zh={fact.title.zh} data-en={fact.title.en}>
                {fact.title.zh}
              </h3>
              <p data-zh={fact.body.zh} data-en={fact.body.en}>
                {fact.body.zh}
              </p>
            </div>
          ))
        }
      </div>
    </section>
  </main>

  <footer class="foot wrap">
    <p>
      <span data-zh={ui.unlisted.zh} data-en={ui.unlisted.en}
        >{ui.unlisted.zh}</span
      >
      <a href="/" data-zh={ui.backHome.zh} data-en={ui.backHome.en}
        >{ui.backHome.zh}</a
      >
    </p>
  </footer>
</div>

<script>
  function initDossierLang() {
    let lang = "zh";

    const applyLang = () => {
      document.documentElement.lang = lang === "zh" ? "zh-CN" : "en";
      document.querySelectorAll("[data-zh][data-en]").forEach((el: Element) => {
        const next = el.getAttribute(`data-${lang}`);
        if (next !== null) el.textContent = next;
      });
    };

    document.getElementById("lang-btn")?.addEventListener("click", event => {
      lang = lang === "zh" ? "en" : "zh";
      const btn = event.currentTarget as HTMLButtonElement;
      btn.textContent = lang === "zh" ? "EN" : "中";
      btn.setAttribute("aria-pressed", lang === "en" ? "true" : "false");
      applyLang();
    });
  }

  initDossierLang();
  document.addEventListener("astro:after-swap", initDossierLang);
</script>

<style>
  .wrap {
    max-width: var(--measure-wide);
    margin: 0 auto;
    padding-inline: var(--gutter);
  }

  .eyebrow {
    margin: 0;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--step-eyebrow);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .mono {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  /* ── 顶部工具条 ─────────────────────────────────────────── */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--line);
    background: var(--canvas);
  }

  .topbar-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 3.25rem;
  }

  .topbar-id {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: var(--step-meta);
    font-weight: 700;
  }

  .topbar-id__alt {
    color: var(--muted);
    font-weight: 400;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.25rem;
    padding: 0 0.7rem;
    border: 1px solid var(--line);
    border-radius: var(--r-control);
    background: var(--surface);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--step-meta);
    font-weight: 700;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition:
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .btn[aria-pressed="true"] {
    border-color: var(--accent);
    color: var(--accent);
  }

  .btn--icon svg {
    width: 1.125rem;
    height: 1.125rem;
    fill: currentColor;
  }

  .draft-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.5rem;
    border: 1px dashed var(--faint);
    border-radius: var(--r-control);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--step-eyebrow);
    letter-spacing: 0.08em;
  }

  /* ── Hero ───────────────────────────────────────────────── */
  .hero {
    padding: var(--s-12) 0 var(--s-8);
    border-bottom: 1px solid var(--line);
  }

  .hero-name {
    margin: var(--s-4) 0 0;
    font-size: var(--step-display);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .hero-name small {
    display: block;
    margin-top: 0.35rem;
    color: var(--muted);
    font-size: 0.3em;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .role-line {
    margin-top: var(--s-4);
    padding-left: 0.85rem;
    border-left: 3px solid var(--accent);
    color: var(--accent);
    font-size: var(--step-h3);
    font-weight: 700;
  }

  .lede {
    max-width: 40em;
    margin-top: var(--s-4);
    font-size: var(--step-lede);
    line-height: 1.75;
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: var(--s-6);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--step-meta);
  }

  .contact a {
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  .contact a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* ── 通用小节 ───────────────────────────────────────────── */
  .section {
    padding-top: var(--s-12);
  }

  .subhead {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  .subhead h2 {
    font-size: var(--step-h2);
    font-weight: 700;
    line-height: 1.25;
  }

  .subhead .count {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--step-meta);
  }

  .subnote {
    max-width: 44em;
    margin-top: var(--s-3);
    color: var(--muted);
    font-size: var(--step-meta);
    line-height: 1.75;
  }

  /* ── 数据宫格 ───────────────────────────────────────────── */
  .metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: var(--s-6);
    border: 1px solid var(--line);
    background: var(--line);
  }

  .metric {
    padding: var(--s-4);
    background: var(--surface);
  }

  .metric b {
    display: block;
    font-family: var(--font-mono);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .metric span {
    display: block;
    margin-top: 0.35rem;
    color: var(--muted);
    font-size: var(--step-meta);
    line-height: 1.5;
  }

  /* ── 核心系统卡 ─────────────────────────────────────────── */
  .systems {
    display: grid;
    gap: 1px;
    margin-top: var(--s-6);
    border: 1px solid var(--line);
    background: var(--line);
  }

  .sys {
    padding: var(--s-4);
    background: var(--surface);
  }

  .sys-no {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--step-eyebrow);
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .sys h3 {
    margin-top: 0.35rem;
    font-size: var(--step-h3);
    font-weight: 700;
    line-height: 1.25;
  }

  .sys p {
    margin-top: 0.5rem;
