---
import type { DigestSource } from "@utils/getDigests";

export interface Props {
  sources: DigestSource[];
  /** Show the numbering the digest body cites, e.g. "[3]". */
  numbered?: boolean;
}

const { sources, numbered = false } = Astro.props;

function shortDate(value: Date | undefined) {
  return value ? value.toISOString().slice(0, 10) : "";
}
---

<ul class:list={["source-list", numbered && "is-numbered"]}>
  {
    sources.map((source, i) => (
      <li>
        {numbered && <span class="source-list__index">[{i + 1}]</span>}
        <a
          href={source.url}
          target="_blank"
          rel="noopener noreferrer"
          class="source-list__link"
        >
          {source.title}
        </a>
        <span class="source-list__meta">
          {source.label}
          {source.publishedAt && ` · ${shortDate(source.publishedAt)}`}
        </span>
      </li>
    ))
  }
</ul>

<style>
  .source-list {
    display: grid;
    gap: 0;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .source-list li {
    display: grid;
    gap: 0.15rem 0.75rem;
    padding: 0.65rem 0;
    border-bottom: var(--hairline);
  }

  .source-list__index {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--step-eyebrow);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .source-list__link {
    color: var(--ink);
    font-size: var(--step-meta);
    font-weight: 500;
    line-height: 1.6;
    text-decoration-color: var(--accent-rule);
  }
  .source-list__link:hover {
    color: var(--accent);
  }

  .source-list__meta {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--step-eyebrow);
    letter-spacing: 0.08em;
  }

  /* 列定义按是否有 [n] 索引分支：无索引时不能留 2.5rem 窄列，否则标题被挤成逐词折行 */
  @media (min-width: 768px) {
    .source-list li {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: baseline;
    }
    .source-list.is-numbered li {
      grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    }
  }
</style>
