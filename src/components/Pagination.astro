---
import LinkButton from "./LinkButton.astro";

export interface Props {
  currentPage: number;
  totalPages: number;
  prevUrl: string;
  nextUrl: string;
}

const { currentPage, totalPages, prevUrl, nextUrl } = Astro.props;

const prev = currentPage > 1 ? "" : "disabled";
const next = currentPage < totalPages ? "" : "disabled";
---

{
  totalPages > 1 && (
    <nav class="pagination" aria-label="Pagination">
      <LinkButton
        disabled={prev === "disabled"}
        href={prevUrl}
        className={`btn pagination__btn ${prev}`}
        ariaLabel="Previous"
      >
        <span aria-hidden="true">←</span> 上一页
      </LinkButton>

      <span class="pagination__status">
        <b>{String(currentPage).padStart(2, "0")}</b>
        <span aria-hidden="true">/</span>
        <span>{String(totalPages).padStart(2, "0")}</span>
      </span>

      <LinkButton
        disabled={next === "disabled"}
        href={nextUrl}
        className={`btn pagination__btn ${next}`}
        ariaLabel="Next"
      >
        下一页 <span aria-hidden="true">→</span>
      </LinkButton>
    </nav>
  )
}

<style>
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    width: 100%;
    max-width: var(--measure-wide);
    margin: 3.5rem auto 0;
    padding: 1.5rem var(--gutter) 0;
    border-top: var(--hairline);
  }

  .pagination__btn {
    text-decoration: none;
  }

  .pagination__btn.disabled {
    color: var(--faint);
    border-color: var(--line);
    border-style: dashed;
    pointer-events: none;
    cursor: not-allowed;
  }

  .pagination__status {
    display: inline-flex;
    gap: 0.4rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--step-meta);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.1em;
  }

  .pagination__status b {
    color: var(--accent);
    font-weight: 700;
  }
</style>
