---
import type { CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Pagination from "@components/Pagination.astro";
import Card from "@components/Card";
import { SITE } from "@config";

export interface Props {
  currentPage: number;
  totalPages: number;
  paginatedPosts: (
    | CollectionEntry<"blog">
    | CollectionEntry<"short-stories">
  )[];
  /** When provided, render all posts with client-side filter (blog index). */
  allPosts?: (CollectionEntry<"blog"> | CollectionEntry<"short-stories">)[];
  collection?: "blog" | "short-stories";
  showPagination?: boolean;
}

const {
  currentPage,
  totalPages,
  paginatedPosts,
  allPosts,
  collection = "blog",
  showPagination: _showPagination = true,
} = Astro.props;

// When allPosts is given we render the full list; pagination is hidden.
const useAllPosts = !!allPosts;
const showPagination = !useAllPosts && _showPagination;

const basePath = collection === "short-stories" ? "/short-stories" : "/posts";
const showFilters = collection === "blog" && useAllPosts;

const getDirectoryKey = (id: string) => {
  const parts = id.split("/");
  return parts.length > 1 ? parts.slice(0, -1).join("/") : "other";
};

const renderPosts = (useAllPosts ? (allPosts ?? []) : paginatedPosts) as (
  | CollectionEntry<"blog">
  | CollectionEntry<"short-stories">
)[];

const dirOptions = showFilters
  ? Array.from(new Set(renderPosts.map(p => getDirectoryKey(p.id)))).sort()
  : [];

const tagOptions = showFilters
  ? Array.from(
      new Set(
        renderPosts.flatMap(p => p.data.tags).map(t => t.trim().toLowerCase())
      )
    ).sort()
  : [];
---

<Layout
  title={`${collection === "short-stories" ? "Short Stories" : "Posts"} | ${SITE.title}`}
>
  <Header activeNav={collection === "short-stories" ? undefined : "posts"} />
  <Breadcrumbs />
  <main id="main-content" class="posts-page">
    <section class="posts-intro">
      <p class="eyebrow">
        {
          collection === "short-stories"
            ? "Fiction / archive"
            : "Writing / archive"
        }
      </p>
      <div class="intro-grid">
        <h1>{collection === "short-stories" ? "Short Stories" : "Posts"}</h1>
        <p>
          {
            collection === "short-stories"
              ? "A complete archive of the short fiction published here."
              : "Long-form notes on software, AI, research and the practical work of building systems."
          }
        </p>
      </div>
    </section>

    <section class="archive-section" aria-labelledby="archive-title">
      <div class="section-heading">
        <h2 id="archive-title">Full archive</h2>
        <span>{renderPosts.length.toString().padStart(2, "0")}</span>
      </div>
      {
        showFilters && (
          <div class="filter-bar" data-post-filter-root>
            {/* Directory pills */}
            <div class="filter-row">
              <span class="filter-label">目录</span>
              <div class="dir-pills">
                <button class="dir-pill is-active" data-dir-btn="">
                  全部
                </button>
                {dirOptions.map(d => (
                  <button class="dir-pill" data-dir-btn={d}>
                    {d}
                  </button>
                ))}
              </div>
            </div>

            {/* Tag select + status */}
            <div class="filter-row">
              <span class="filter-label">标签</span>
              <select class="tag-select" data-filter-tag>
                <option value="">全部标签</option>
                {tagOptions.map(t => (
                  <option value={t}>{t}</option>
                ))}
              </select>
              <span class="filter-meta">
                <span data-filter-summary>{renderPosts.length} 篇</span>
                <button class="clear-btn is-hidden" data-filter-clear>
                  × 清除
                </button>
              </span>
            </div>
          </div>
        )
      }

      <ul class="post-list">
        {
          renderPosts.map(({ data, slug, id }) => {
            const directory = getDirectoryKey(id);
            const tags = data.tags.map(t => t.trim().toLowerCase()).join("|");
            return (
              <Card
                href={`${basePath}/${slug}/`}
                frontmatter={data}
                itemClassName="post-item"
                itemData={{
                  "data-post-dir": directory,
                  "data-post-tags": tags,
                }}
              />
            );
          })
        }
      </ul>
    </section>
  </main>

  {
    showPagination && (
      <Pagination
        {currentPage}
        {totalPages}
        prevUrl={`${basePath}${currentPage - 1 !== 1 ? "/" + (currentPage - 1) : ""}/`}
        nextUrl={`${basePath}/${currentPage + 1}/`}
      />
    )
  }

  <Footer noMarginTop={showPagination && totalPages > 1} />
</Layout>

<style>
  .posts-page {
    --editorial-line: rgb(var(--color-text-base) / 0.18);
    --editorial-muted: rgb(var(--color-text-base) / 0.68);
    width: 100%;
    overflow-x: clip;
    padding-bottom: 4rem;
  }

  :global(html),
  :global(body) {
    overflow-x: clip;
  }

  .posts-intro,
  .archive-section {
    max-width: 72rem;
    margin: 0 auto;
    padding-inline: 1rem;
  }

  .posts-intro {
    padding-top: 3.5rem;
    padding-bottom: 4rem;
    border-bottom: 1px solid var(--editorial-line);
  }

  .eyebrow {
    margin: 0;
    color: var(--editorial-muted);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .intro-grid {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.25rem;
  }

  .intro-grid h1 {
    margin: 0;
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .intro-grid > p {
    max-width: 36rem;
    margin: 0;
    align-self: end;
    color: var(--editorial-muted);
    font-size: 1rem;
    line-height: 1.75;
  }

  .archive-section {
    padding-top: 4rem;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--editorial-line);
  }

  .section-heading h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
  }

  .section-heading span {
    color: var(--editorial-muted);
    font-size: 0.75rem;
  }

  .post-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ── Filter bar ──────────────────────────────────────── */
  .filter-bar {
    @apply flex flex-col gap-3 border-b border-skin-line py-5;
  }
  .filter-row {
    @apply flex flex-wrap items-center gap-x-3 gap-y-2;
  }
  .filter-label {
    @apply shrink-0 text-xs font-semibold uppercase tracking-widest opacity-50;
  }

  /* Directory pill buttons */
  .dir-pills {
    @apply flex flex-wrap gap-1.5;
  }
  .dir-pill {
    @apply cursor-pointer rounded-full border border-skin-line px-3 py-0.5
           text-sm transition-colors
           hover:border-skin-accent hover:text-skin-accent;
  }
  .dir-pill.is-active {
    @apply border-skin-accent bg-skin-accent/10 font-medium text-skin-accent;
  }

  /* Tag select */
  .tag-select {
    @apply cursor-pointer rounded border border-skin-line bg-skin-fill
           px-2 py-1 text-sm text-skin-base outline-none
           transition-colors hover:border-skin-accent;
  }

  /* Status + clear */
  .filter-meta {
    @apply flex items-center gap-2 text-sm;
  }
  [data-filter-summary] {
    @apply opacity-50;
  }
  .clear-btn {
    @apply cursor-pointer rounded border border-skin-line px-2 py-0.5
           text-xs opacity-60 transition-all
           hover:border-skin-accent hover:text-skin-accent hover:opacity-100;
  }
  .clear-btn.is-hidden {
    display: none;
  }

  /* Hidden post items — Card.tsx renders the <li>, so needs :global() to escape Astro scoping */
  :global(.post-item.is-hidden) {
    display: none;
  }

  @media (min-width: 640px) {
    .posts-intro,
    .archive-section {
      padding-inline: 2rem;
    }

    .intro-grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
    }
  }
</style>

<script>
  function setupPostFilters() {
    const root = document.querySelector<HTMLElement>("[data-post-filter-root]");
    if (!root) return;

    const dirBtns = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-dir-btn]")
    );
    const tagSelect =
      root.querySelector<HTMLSelectElement>("[data-filter-tag]");
    const summary = root.querySelector<HTMLElement>("[data-filter-summary]");
    const clearBtn = root.querySelector<HTMLButtonElement>(
      "[data-filter-clear]"
    );
    const items = Array.from(
      document.querySelectorAll<HTMLElement>(".post-item")
    );

    if (!tagSelect || !summary || !clearBtn || items.length === 0) return;

    let activeDir = "";
    let activeTag = "";

    const applyFilters = () => {
      let visible = 0;
      items.forEach(item => {
        const itemDir = item.getAttribute("data-post-dir") ?? "";
        const itemTags = (item.getAttribute("data-post-tags") ?? "").split("|");
        const dirMatch = !activeDir || itemDir === activeDir;
        const tagMatch = !activeTag || itemTags.includes(activeTag);
        const show = dirMatch && tagMatch;
        item.classList.toggle("is-hidden", !show);
        if (show) visible++;
      });

      const total = items.length;
      summary.textContent =
        activeDir || activeTag ? `${visible} / ${total} 篇` : `${total} 篇`;
      clearBtn.classList.toggle("is-hidden", !activeDir && !activeTag);
    };

    dirBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        dirBtns.forEach(b => b.classList.remove("is-active"));
        btn.classList.add("is-active");
        activeDir = btn.getAttribute("data-dir-btn") ?? "";
        applyFilters();
      });
    });

    tagSelect.addEventListener("change", () => {
      activeTag = tagSelect.value;
      applyFilters();
    });

    clearBtn.addEventListener("click", () => {
      activeDir = "";
      activeTag = "";
      tagSelect.value = "";
      dirBtns.forEach(b => b.classList.remove("is-active"));
      dirBtns[0]?.classList.add("is-active");
      applyFilters();
    });
  }

  setupPostFilters();
  document.addEventListener("astro:after-swap", setupPostFilters);
</script>
