---
import type { CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Pagination from "@components/Pagination.astro";
import SectionHeader from "@components/SectionHeader.astro";
import Card from "@components/Card.astro";
import { LOCALE, SITE } from "@config";

export interface Props {
  currentPage: number;
  totalPages: number;
  paginatedPosts: (
    | CollectionEntry<"blog">
    | CollectionEntry<"short-stories">
  )[];
  /** When provided, render all posts with client-side filter (blog index). */
  allPosts?: (CollectionEntry<"blog"> | CollectionEntry<"short-stories">)[];
  collection?: "blog" | "short-stories";
  showPagination?: boolean;
}

const {
  currentPage,
  totalPages,
  paginatedPosts,
  allPosts,
  collection = "blog",
  showPagination: _showPagination = true,
} = Astro.props;

// When allPosts is given we render the full list; pagination is hidden.
const useAllPosts = !!allPosts;
const showPagination = !useAllPosts && _showPagination;

const basePath = collection === "short-stories" ? "/short-stories" : "/posts";
const showFilters = collection === "blog" && useAllPosts;
const isShortStories = collection === "short-stories";

const getDirectoryKey = (id: string) => {
  const parts = id.split("/");
  return parts.length > 1 ? parts.slice(0, -1).join("/") : "other";
};

const renderPosts = (useAllPosts ? (allPosts ?? []) : paginatedPosts) as (
  | CollectionEntry<"blog">
  | CollectionEntry<"short-stories">
)[];

const dirOptions = showFilters
  ? Array.from(new Set(renderPosts.map(p => getDirectoryKey(p.id)))).sort()
  : [];

const tagOptions = showFilters
  ? Array.from(
      new Set(
        renderPosts.flatMap(p => p.data.tags).map(t => t.trim().toLowerCase())
      )
    ).sort()
  : [];

/* ── 按年份分组：给 180 篇平铺列表一个可导航的骨架 ────────── */
type Grouped = { year: string; items: typeof renderPosts };
const groups: Grouped[] = [];
for (const post of renderPosts) {
  const d = new Date(
    post.data.modDatetime && post.data.modDatetime > post.data.pubDatetime
      ? post.data.modDatetime
      : post.data.pubDatetime
  );
  const year = d.toLocaleDateString(LOCALE.langTag, { year: "numeric" });
  const last = groups[groups.length - 1];
  if (last && last.year === year) last.items.push(post);
  else groups.push({ year, items: [post] });
}

const years = renderPosts.map(p => new Date(p.data.pubDatetime).getFullYear());
const span =
  years.length > 0 ? `${Math.min(...years)}–${Math.max(...years)}` : "—";

const stats = [
  {
    label: "存档篇数",
    value: String(renderPosts.length).padStart(3, "0"),
    accent: true,
  },
  { label: "领域", value: String(dirOptions.length || 1).padStart(2, "0") },
  { label: "标签", value: String(tagOptions.length || 0).padStart(2, "0") },
  { label: "跨度", value: span },
];
---

<Layout title={`${isShortStories ? "Short Stories" : "Posts"} | ${SITE.title}`}>
  <Header activeNav={isShortStories ? undefined : "posts"} />
  <Breadcrumbs />

  <main id="main-content">
    <section class="hero" aria-labelledby="posts-title">
      <p class="eyebrow">
        {isShortStories ? "虚构 / 存档" : "写作 / 存档"}
      </p>
      <div class="hero__grid">
        <h1 id="posts-title" class="hero__title">
          {isShortStories ? "短篇故事" : "全部写作"}
        </h1>
        <div class="hero__copy">
          <p>
            {
              isShortStories
                ? "这里收录发布过的短篇小说，按时间倒序排列。"
                : "关于软件、AI 与构建系统的长文记录。每篇都尽量给出可核验的依据，而不是结论。"
            }
          </p>
          <nav class="hero__links" aria-label="归档导航">
            <a href="/tags/">按标签浏览 <span aria-hidden="true">↗</span></a>
            <a href="/rss.xml">订阅 RSS <span aria-hidden="true">↗</span></a>
          </nav>
        </div>
      </div>

      <dl class="stat-row">
        {
          stats.map(s => (
            <div class:list={["stat", { "stat--accent": s.accent }]}>
              <dt class="stat__label">{s.label}</dt>
              <dd class="stat__value">{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="block-section" aria-labelledby="archive-title">
      <SectionHeader
        id="archive-title"
        title="完整归档"
        count={renderPosts.length}
      />

      {
        showFilters && (
          <div class="filter-bar" data-post-filter-root>
            <div class="filter-row">
              <span class="filter-label">领域</span>
              <div class="filter-pills">
                <button
                  class="pill is-active"
                  data-dir-btn=""
                  aria-pressed="true"
                  type="button"
                >
                  全部
                </button>
                {dirOptions.map(d => (
                  <button
                    class="pill"
                    data-dir-btn={d}
                    aria-pressed="false"
                    type="button"
                  >
                    {d}
                  </button>
                ))}
              </div>
            </div>

            <div class="filter-row">
              <span class="filter-label">标签</span>
              <select
                class="filter-select"
                data-filter-tag
                aria-label="按标签筛选"
              >
                <option value="">全部标签</option>
                {tagOptions.map(t => (
                  <option value={t}>{t}</option>
                ))}
              </select>
              <span class="filter-meta">
                <span data-filter-summary aria-live="polite">
                  {renderPosts.length} 篇
                </span>
                <button
                  class="clear-btn is-hidden"
                  data-filter-clear
                  type="button"
                >
                  × 清除筛选
                </button>
              </span>
            </div>
          </div>
        )
      }

      {
        groups.length === 0 ? (
          <p class="t-muted" style="padding-top:2rem">
            这个归档暂时是空的。
          </p>
        ) : (
          groups.map(group => (
            <div class="year-group" data-year-group>
              <div class="year-head">
                <h3 class="year-head__num">{group.year}</h3>
                <span class="year-head__count">{group.items.length} 篇</span>
              </div>
              <ul class="post-list">
                {group.items.map(({ data, slug, id }) => (
                  <Card
                    href={`${basePath}/${slug}/`}
                    frontmatter={data}
                    headingLevel={4}
                    itemClassName="post-item"
                    itemData={{
                      "data-post-dir": getDirectoryKey(id),
                      "data-post-tags": data.tags
                        .map(t => t.trim().toLowerCase())
                        .join("|"),
                    }}
                  />
                ))}
              </ul>
            </div>
          ))
        )
      }
    </section>
  </main>

  {
    showPagination && (
      <Pagination
        {currentPage}
        {totalPages}
        prevUrl={`${basePath}${currentPage - 1 !== 1 ? "/" + (currentPage - 1) : ""}/`}
        nextUrl={`${basePath}/${currentPage + 1}/`}
      />
    )
  }

  <Footer noMarginTop={showPagination && totalPages > 1} />
</Layout>

<script>
  function setupPostFilters() {
    const root = document.querySelector<HTMLElement>("[data-post-filter-root]");
    if (!root) return;

    const dirBtns = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-dir-btn]")
    );
    const tagSelect =
      root.querySelector<HTMLSelectElement>("[data-filter-tag]");
    const summary = root.querySelector<HTMLElement>("[data-filter-summary]");
    const clearBtn = root.querySelector<HTMLButtonElement>(
      "[data-filter-clear]"
    );
    const items = Array.from(
      document.querySelectorAll<HTMLElement>(".post-item")
    );
    const groups = Array.from(
      document.querySelectorAll<HTMLElement>("[data-year-group]")
    );

    if (!tagSelect || !summary || !clearBtn || items.length === 0) return;

    let activeDir = "";
    let activeTag = "";

    const applyFilters = () => {
      let visible = 0;

      items.forEach(item => {
        const itemDir = item.getAttribute("data-post-dir") ?? "";
        const itemTags = (item.getAttribute("data-post-tags") ?? "").split("|");
        const dirMatch = !activeDir || itemDir === activeDir;
        const tagMatch = !activeTag || itemTags.includes(activeTag);
        const show = dirMatch && tagMatch;
        item.classList.toggle("is-hidden", !show);
        if (show) visible++;
      });

      // 年份分组会整组清空，必须一起隐藏，否则留下空标题
      groups.forEach(group => {
        const anyVisible = group.querySelector(".post-item:not(.is-hidden)");
        group.hidden = !anyVisible;
      });

      const total = items.length;
      summary.textContent =
        activeDir || activeTag ? `${visible} / ${total} 篇` : `${total} 篇`;
      clearBtn.classList.toggle("is-hidden", !activeDir && !activeTag);
    };

    dirBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        dirBtns.forEach(b => {
          b.classList.remove("is-active");
          b.setAttribute("aria-pressed", "false");
        });
        btn.classList.add("is-active");
        btn.setAttribute("aria-pressed", "true");
        activeDir = btn.getAttribute("data-dir-btn") ?? "";
        applyFilters();
      });
    });

    tagSelect.addEventListener("change", () => {
      activeTag = tagSelect.value;
      applyFilters();
    });

    clearBtn.addEventListener("click", () => {
      activeDir = "";
      activeTag = "";
      tagSelect.value = "";
      dirBtns.forEach(b => {
        b.classList.remove("is-active");
        b.setAttribute("aria-pressed", "false");
      });
      dirBtns[0]?.classList.add("is-active");
      dirBtns[0]?.setAttribute("aria-pressed", "true");
      applyFilters();
    });
  }

  setupPostFilters();
  document.addEventListener("astro:after-swap", setupPostFilters);
</script>
