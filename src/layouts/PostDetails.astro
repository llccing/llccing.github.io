---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Tag from "@components/Tag.astro";
import Datetime from "@components/Datetime";
import { type CollectionEntry, getEntry } from "astro:content";
import { slugifyStr } from "@utils/slugify";
import ShareLinks from "@components/ShareLinks.astro";
import Comments from "@components/Comments";
import InlineComments from "@components/InlineComments";
import { SITE } from "@config";

export interface Props {
  post: CollectionEntry<"blog"> | CollectionEntry<"short-stories">;
}

const { post } = Astro.props;

const {
  title,
  author,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
} = post.data;

const { Content, headings, remarkPluginFrontmatter } = await post.render();
const minutesRead = remarkPluginFrontmatter?.minutesRead;
const tocHeadings = headings.filter(h => h.depth >= 2 && h.depth <= 3);
const commentsApiUrl = import.meta.env.PUBLIC_COMMENTS_API_URL;
const inlineCommentsEnabled =
  import.meta.env.PUBLIC_INLINE_COMMENTS === "true" && Boolean(commentsApiUrl);

// Translation support
const isTranslation =
  "isTranslation" in post.data && post.data.isTranslation === true;
let OriginalContent: any = null;
if (isTranslation) {
  const originalEntry = await getEntry("originals", post.slug);
  if (originalEntry) {
    const result = await originalEntry.render();
    OriginalContent = result.Content;
  }
}

const ogImageUrl = typeof ogImage === "string" ? ogImage : ogImage?.src;
const ogUrl = new URL(
  ogImageUrl ?? `/posts/${slugifyStr(title)}.png`,
  Astro.url.origin
).href;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage: ogUrl,
  scrollSmooth: true,
};
---

<Layout {...layoutProps}>
  <Header />

  <!-- <div class="progress-container fixed top-0 z-10 h-1 w-full bg-skin-fill">
    <div class="progress-bar h-1 w-0 bg-skin-accent" id="myBar"></div>
  </div> -->

  <div class="mx-auto flex w-full max-w-3xl justify-start px-2">
    <button
      class="focus-outline mb-2 mt-8 flex hover:opacity-75"
      onclick="(() => (history.length === 1) ? window.location = '/' : history.back())()"
    >
      <svg xmlns="http://www.w3.org/2000/svg"
        ><path
          d="M13.293 6.293 7.586 12l5.707 5.707 1.414-1.414L10.414 12l4.293-4.293z"
        ></path>
      </svg><span>Go back</span>
    </button>
  </div>
  <main id="main-content">
    <h1 transition:name={slugifyStr(title)} class="post-title">{title}</h1>
    <Datetime
      pubDatetime={pubDatetime}
      modDatetime={modDatetime}
      size="lg"
      className="my-2"
      readingTime={minutesRead}
    />
    {
      isTranslation && OriginalContent ? (
        <>
          <div class="translation-controls mx-auto mt-4 flex max-w-3xl items-center gap-1 rounded-lg bg-skin-card bg-opacity-60 p-1">
            <button class="toggle-btn active" data-view="translated">
              译文
            </button>
            <button class="toggle-btn" data-view="original">
              原文
            </button>
            <button class="toggle-btn" data-view="comparison">
              对照
            </button>
          </div>
          <div id="translation-container" class="mt-8">
            <article
              id="article-original"
              role="article"
              class="prose mx-auto max-w-3xl"
              hidden
            >
              <OriginalContent />
            </article>
            <article
              id="article-translated"
              role="article"
              class="prose mx-auto max-w-3xl"
            >
              {tocHeadings.length >= 3 && (
                <details class="toc" open>
                  <summary class="cursor-pointer font-bold">目录</summary>
                  <ul class="mt-2">
                    {tocHeadings.map(h => (
                      <li style={`margin-left: ${(h.depth - 2) * 1}rem`}>
                        <a href={`#${h.slug}`}>{h.text}</a>
                      </li>
                    ))}
                  </ul>
                </details>
              )}
              <Content />
            </article>
          </div>
        </>
      ) : (
        <article
          id="article"
          role="article"
          class="prose mx-auto mt-8 max-w-3xl"
        >
          {tocHeadings.length >= 3 && (
            <details class="toc" open>
              <summary class="cursor-pointer font-bold">目录</summary>
              <ul class="mt-2">
                {tocHeadings.map(h => (
                  <li style={`margin-left: ${(h.depth - 2) * 1}rem`}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </details>
          )}
          <Content />
        </article>
      )
    }

    {
      inlineCommentsEnabled && (
        <InlineComments
          apiUrl={commentsApiUrl}
          articlePath={Astro.url.pathname}
          articleTitle={title}
          client:only="react"
        />
      )
    }

    <ul class="my-8">
      {tags.map(tag => <Tag tag={slugifyStr(tag)} />)}
    </ul>

    <div
      class="flex flex-col-reverse items-center justify-between gap-6 sm:flex-row-reverse sm:items-end sm:gap-4"
    >
      <button
        id="back-to-top"
        class="focus-outline whitespace-nowrap py-1 hover:opacity-75"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="rotate-90">
          <path
            d="M13.293 6.293 7.586 12l5.707 5.707 1.414-1.414L10.414 12l4.293-4.293z"
          ></path>
        </svg>
        <span>Back to Top</span>
      </button>

      <ShareLinks />
    </div>

    <Comments client:only="react" />
  </main>
  <Footer />
</Layout>

<style>
  main {
    @apply mx-auto w-full max-w-3xl px-4 pb-12;
    transition: max-width 0.3s ease;
  }
  main.comparison-active {
    max-width: 90rem;
  }
  .post-title {
    @apply text-2xl font-semibold text-skin-accent;
  }
  .toggle-btn {
    @apply flex-1 cursor-pointer rounded-md px-3 py-1.5 text-center text-sm font-medium text-skin-base transition-colors;
  }
  .toggle-btn.active {
    @apply bg-skin-accent text-skin-inverted;
  }
  .toggle-btn:not(.active):hover {
    @apply bg-skin-card-muted;
  }
  #translation-container.comparison-mode {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }
  @media (max-width: 640px) {
    #translation-container.comparison-mode {
      grid-template-columns: 1fr;
    }
  }
  #translation-container.comparison-mode article {
    max-width: none;
  }
</style>

<script is:inline>
  /** Create a progress indicator
   *  at the top */
  function createProgressBar() {
    // Create the main container div
    const progressContainer = document.createElement("div");
    progressContainer.className =
      "progress-container fixed top-0 z-10 h-1 w-full bg-skin-fill";

    // Create the progress bar div
    const progressBar = document.createElement("div");
    progressBar.className = "progress-bar h-1 w-0 bg-skin-accent";
    progressBar.id = "myBar";

    // Append the progress bar to the progress container
    progressContainer.appendChild(progressBar);

    // Append the progress container to the document body or any other desired parent element
    document.body.appendChild(progressContainer);
  }
  createProgressBar();

  /** Update the progress bar
   *  when user scrolls */
  function updateScrollProgress() {
    const winScroll =
      document.body.scrollTop || document.documentElement.scrollTop;
    const height =
      document.documentElement.scrollHeight -
      document.documentElement.clientHeight;
    const scrolled = (winScroll / height) * 100;
    if (document) {
      const myBar = document.getElementById("myBar");
      if (myBar) {
        myBar.style.width = scrolled + "%";
      }
    }
  }
  document.addEventListener("scroll", updateScrollProgress);

  /** Attaches links to headings in the document,
   *  allowing sharing of sections easily */
  function addHeadingLinks() {
    let headings = Array.from(document.querySelectorAll("h2, h3, h4, h5, h6"));
    for (let heading of headings) {
      heading.classList.add("group");
      let link = document.createElement("a");
      link.innerText = "#";
      link.className = "heading-link hidden group-hover:inline-block ml-2";
      link.href = "#" + heading.id;
      link.ariaHidden = "true";
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  /** Attaches copy buttons to code blocks in the document,
   * allowing users to copy code easily. */
  function attachCopyButtons() {
    let copyButtonLabel = "Copy";
    let codeBlocks = Array.from(document.querySelectorAll("pre"));

    for (let codeBlock of codeBlocks) {
      let wrapper = document.createElement("div");
      wrapper.style.position = "relative";

      let copyButton = document.createElement("button");
      copyButton.className =
        "copy-code absolute right-3 -top-3 rounded bg-skin-card px-2 py-1 text-xs leading-4 text-skin-base font-medium";
      copyButton.innerHTML = copyButtonLabel;
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);

      // wrap codebock with relative parent element
      codeBlock?.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);

      copyButton.addEventListener("click", async () => {
        await copyCode(codeBlock, copyButton);
      });
    }

    async function copyCode(block, button) {
      let code = block.querySelector("code");
      let text = code?.innerText;

      await navigator.clipboard.writeText(text ?? "");

      // visual feedback that task is completed
      button.innerText = "Copied";

      setTimeout(() => {
        button.innerText = copyButtonLabel;
      }, 700);
    }
  }
  attachCopyButtons();

  /** Scrolls the document to the top when
   * the "Back to Top" button is clicked. */
  function backToTop() {
    document.querySelector("#back-to-top")?.addEventListener("click", () => {
      document.body.scrollTop = 0; // For Safari
      document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    });
  }
  backToTop();

  /** Translation view toggle */
  function initTranslationToggle() {
    var controls = document.querySelector(".translation-controls");
    if (!controls) return;

    var buttons = controls.querySelectorAll(".toggle-btn");
    var container = document.getElementById("translation-container");
    var translated = document.getElementById("article-translated");
    var original = document.getElementById("article-original");
    var main = document.getElementById("main-content");

    function switchView(view) {
      buttons.forEach(function (b) {
        b.classList.remove("active");
      });
      var activeBtn = controls.querySelector('[data-view="' + view + '"]');
      if (activeBtn) activeBtn.classList.add("active");

      container.classList.remove("comparison-mode");
      main.classList.remove("comparison-active");

      if (view === "translated") {
        translated.hidden = false;
        original.hidden = true;
      } else if (view === "original") {
        translated.hidden = true;
        original.hidden = false;
      } else {
        translated.hidden = false;
        original.hidden = false;
        container.classList.add("comparison-mode");
        main.classList.add("comparison-active");
      }

      try {
        sessionStorage.setItem("translation-view-mode", view);
      } catch (e) {
        // Storage can be unavailable in private browsing modes.
      }
    }

    buttons.forEach(function (btn) {
      btn.addEventListener("click", function () {
        switchView(btn.dataset.view);
      });
    });

    // Restore saved mode
    try {
      var saved = sessionStorage.getItem("translation-view-mode");
      if (saved && saved !== "translated") switchView(saved);
    } catch (e) {
      // Keep the default view when storage is unavailable.
    }
  }
  initTranslationToggle();
</script>
