---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Tag from "@components/Tag.astro";
import MetaRow from "@components/MetaRow.astro";
import Toc from "@components/Toc.astro";
import { type CollectionEntry, getCollection, getEntry } from "astro:content";
import { slugifyStr } from "@utils/slugify";
import ShareLinks from "@components/ShareLinks.astro";
import Comments from "@components/Comments";
import InlineComments from "@components/InlineComments";
import { LOCALE, SITE } from "@config";
import getSortedPosts from "@utils/getSortedPosts";

export interface Props {
  post: CollectionEntry<"blog"> | CollectionEntry<"short-stories">;
}

const { post } = Astro.props;

const {
  title,
  author,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
} = post.data;

const { Content, headings, remarkPluginFrontmatter } = await post.render();
const minutesRead = remarkPluginFrontmatter?.minutesRead;
const commentsApiUrl = import.meta.env.PUBLIC_COMMENTS_API_URL;
const inlineCommentsEnabled = import.meta.env.PUBLIC_INLINE_COMMENTS === "true";

/* ── 档案元数据：编号 / 领域 / 篇幅 / 证据来源数 ───────────── */
const isBlog = post.collection === "blog";

const DOMAIN_LABELS: Record<string, string> = {
  frontend: "前端工程",
  life: "生活记录",
  other: "杂记",
  ai: "AI",
  backend: "后端工程",
};

const domainKey = post.id.includes("/")
  ? post.id.split("/").slice(0, -1).join("/")
  : "other";
const domainLabel = DOMAIN_LABELS[domainKey] ?? domainKey;

let docNo = "---";
let totalNo = 0;
if (isBlog) {
  const allPosts = getSortedPosts(await getCollection("blog"));
  totalNo = allPosts.length;
  const idx = allPosts.findIndex(p => p.slug === post.slug);
  if (idx >= 0) docNo = String(totalNo - idx).padStart(3, "0");
}

// 证据块与外链都从原始正文统计 —— 这是「一手证据」文章的骨架强度
const body =
  typeof (post as { body?: string }).body === "string"
    ? (post as { body?: string }).body!
    : "";
const evidenceCount = (body.match(/is-evidence/g) ?? []).length;
const citationCount = new Set(body.match(/https?:\/\/[^\s)"'）」』\]]+/g) ?? [])
  .size;

const shortDate = (d: Date) =>
  d.toLocaleDateString(LOCALE.langTag, {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  });

const railMeta = [
  { label: "编号", value: isBlog ? `No.${docNo}` : "NO." },
  { label: "领域", value: domainLabel },
  { label: "发布于", value: shortDate(new Date(pubDatetime)) },
  ...(modDatetime && modDatetime > pubDatetime
    ? [{ label: "更新于", value: shortDate(new Date(modDatetime)) }]
    : []),
  { label: "篇幅", value: minutesRead ?? "—" },
  { label: "域外引用", value: `${citationCount}` },
  ...(evidenceCount > 0
    ? [{ label: "反例举证", value: `${evidenceCount}` }]
    : []),
];

const inlineMeta: typeof railMeta = [
  { label: "归档", value: isBlog ? `No.${docNo} / ${totalNo}` : "NO." },
  { label: "更新", value: shortDate(new Date(modDatetime ?? pubDatetime)) },
  { label: "篇幅", value: minutesRead ?? "—" },
  ...(evidenceCount > 0
    ? [{ label: "举证", value: `${evidenceCount} 处` }]
    : []),
];

// Translation support
const isTranslation =
  "isTranslation" in post.data && post.data.isTranslation === true;
let OriginalContent: any = null;
if (isTranslation) {
  const originalEntry = await getEntry("originals", post.slug);
  if (originalEntry) {
    const result = await originalEntry.render();
    OriginalContent = result.Content;
  }
}

const ogImageUrl = typeof ogImage === "string" ? ogImage : ogImage?.src;
const ogUrl = new URL(
  ogImageUrl ?? `/posts/${slugifyStr(title)}.png`,
  Astro.url.origin
).href;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage: ogUrl,
  scrollSmooth: true,
};
---

<Layout {...layoutProps}>
  <Header />

  <div
    class="mx-auto w-full"
    style="max-width: var(--measure-wide); padding-inline: var(--gutter)"
  >
    <a class="doc-back focus-outline" href="/posts/">
      <span aria-hidden="true">←</span> 返回归档
    </a>
  </div>

  <main id="main-content" class="dossier">
    <header class="dossier__head">
      <p class="eyebrow dossier__eyebrow">
        {domainLabel} · {isBlog ? `No.${docNo}` : "存档"}
      </p>
      <h1 transition:name={slugifyStr(title)} class="dossier__title">
        {title}
      </h1>
      {description && <p class="dossier__lede">{description}</p>}
      <MetaRow items={inlineMeta} orientation="inline" />
    </header>

    <div class="dossier__grid">
      <aside class="dossier__rail" aria-label="文档信息">
        <MetaRow items={railMeta} orientation="stack" />
        <Toc headings={headings} />
      </aside>

      <div class="dossier__content">
        {
          isTranslation && OriginalContent ? (
            <>
              <div
                class="translation-controls"
                role="group"
                aria-label="译文切换"
              >
                <button class="pill is-active" data-view="translated">
                  译文
                </button>
                <button class="pill" data-view="original">
                  原文
                </button>
                <button class="pill" data-view="comparison">
                  对照
                </button>
              </div>
              <div id="translation-container">
                <article
                  id="article-original"
                  role="article"
                  class="prose"
                  hidden
                >
                  <OriginalContent />
                </article>
                <article id="article-translated" role="article" class="prose">
                  <Content />
                </article>
              </div>
            </>
          ) : (
            <article id="article" role="article" class="prose">
              <Content />
            </article>
          )
        }

        {
          tags.length > 0 && (
            <div class="dossier__tags">
              <p class="eyebrow">标签</p>
              <ul class="tag-list">
                {tags.map(t => (
                  <Tag tag={slugifyStr(t)} />
                ))}
              </ul>
            </div>
          )
        }

        <div class="dossier__actions">
          <ShareLinks />
          <button id="back-to-top" class="btn" type="button">
            <span aria-hidden="true">↑</span> 回到顶部
          </button>
        </div>

        {
          inlineCommentsEnabled && (
            <InlineComments
              apiUrl={commentsApiUrl ?? ""}
              articlePath={Astro.url.pathname}
              articleTitle={title}
              client:only="react"
            />
          )
        }
      </div>
    </div>
  </main>

  <Footer />
  <Comments client:only="react" />
</Layout>

<style>
  .doc-back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 2rem 0 0;
    padding: 0.4rem 0.75rem 0.4rem 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--step-eyebrow);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .doc-back:hover {
    color: var(--accent);
  }

  .dossier {
    width: 100%;
    max-width: var(--measure-wide);
    margin: 0 auto;
    padding: 0 var(--gutter) 5rem;
  }

  /* ── 文档头 ───────────────────────────────────────────── */
  .dossier__head {
    padding: 2.5rem 0 2.5rem;
    border-bottom: 2px solid var(--ink);
  }

  .dossier__eyebrow {
    color: var(--accent);
  }

  .dossier__title {
    margin: 0.75rem 0 0;
    max-width: 20ch;
    font-size: var(--step-h1);
    font-weight: 700;
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
  }

  .dossier__lede {
    margin: 1.25rem 0 0;
    max-width: 46em;
    color: var(--muted);
    font-size: var(--step-lede);
    line-height: 1.72;
  }

  .dossier__head :global(.meta-row) {
    margin-top: 1.5rem;
  }

  /* ── 栅格：宽屏双栏 ───────────────────────────────────── */
  .dossier__grid {
    display: grid;
    gap: 0;
  }

  @media (min-width: 1200px) {
    .dossier__grid {
      grid-template-columns: 15rem minmax(0, var(--measure-post));
      gap: 4rem;
      justify-content: start;
    }
  }

  .dossier__rail {
    padding: 2.5rem 0 0;
    display: grid;
    gap: 2rem;
    align-content: start;
  }

  /* 窄屏：目录限高可滚动，不要吞掉整屏 */
  .dossier__rail :global(.toc) {
    max-height: 40vh;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  @media (min-width: 1200px) {
    .dossier__rail {
      position: sticky;
      top: 2rem;
      max-height: calc(100vh - 4rem);
      overflow-y: auto;
      padding-bottom: 2rem;
    }
    .dossier__rail :global(.toc) {
      max-height: none;
      overflow: visible;
    }
  }

  .dossier__content {
    min-width: 0;
    padding-top: 2.5rem;
  }

  @media (min-width: 1200px) {
    .dossier__content {
      padding-top: 2.5rem;
    }
  }

  .dossier__content :global(.prose) {
    max-width: none;
  }

  /* ── 译文切换 ─────────────────────────────────────────── */
  .translation-controls {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: var(--hairline);
  }

  #translation-container.comparison-mode {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 1024px) {
    #translation-container.comparison-mode {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ── 标签区 ───────────────────────────────────────────── */
  .dossier__tags {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: var(--hairline);
  }
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  /* ── 操作区 ───────────────────────────────────────────── */
  .dossier__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: var(--hairline);
  }
</style>

<script is:inline>
  /** 顶部阅读进度 */
  function createProgressBar() {
    const container = document.createElement("div");
    container.className = "fixed left-0 top-0 z-20 h-0.5 w-full";
    const bar = document.createElement("div");
    bar.className = "h-0.5 w-0 bg-accent";
    bar.id = "myBar";
    container.appendChild(bar);
    document.body.appendChild(container);
  }
  createProgressBar();

  function updateScrollProgress() {
    const winScroll =
      document.body.scrollTop || document.documentElement.scrollTop;
    const height =
      document.documentElement.scrollHeight -
      document.documentElement.clientHeight;
    const scrolled = (winScroll / height) * 100;
    const myBar = document.getElementById("myBar");
    if (myBar) myBar.style.width = scrolled + "%";
  }
  document.addEventListener("scroll", updateScrollProgress);

  /** 标题锚点 */
  function addHeadingLinks() {
    const headings = Array.from(
      document.querySelectorAll(".prose h2, .prose h3, .prose h4")
    );
    for (const heading of headings) {
      if (!heading.id) continue;
      heading.classList.add("group");
      const link = document.createElement("a");
      link.innerText = "#";
      link.className = "heading-link";
      link.href = "#" + heading.id;
      link.setAttribute("aria-hidden", "true");
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  /** 代码块复制 */
  function attachCopyButtons() {
    const label = "Copy";
    const codeBlocks = Array.from(document.querySelectorAll("pre"));

    for (const block of codeBlocks) {
      const wrapper = document.createElement("div");
      wrapper.style.position = "relative";

      const btn = document.createElement("button");
      btn.className = "copy-code";
      btn.type = "button";
      btn.innerHTML = label;
      block.setAttribute("tabindex", "0");
      block.appendChild(btn);

      block?.parentNode?.insertBefore(wrapper, block);
      wrapper.appendChild(block);

      btn.addEventListener("click", async () => {
        const code = block.querySelector("code");
        const text = code?.textContent ?? "";
        await navigator.clipboard.writeText(text);
        btn.innerText = "Copied";
        setTimeout(() => {
          btn.innerText = label;
        }, 700);
      });
    }
  }
  attachCopyButtons();

  /** 回到顶部 */
  document.querySelector("#back-to-top")?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });

  /** 译文切换 */
  function initTranslationToggle() {
    const controls = document.querySelector(".translation-controls");
    if (!controls) return;

    const buttons = Array.from(
      controls.querySelectorAll<HTMLButtonElement>(".pill")
    );
    const container = document.getElementById("translation-container");
    const translated = document.getElementById("article-translated");
    const original = document.getElementById("article-original");

    function switchView(view) {
      buttons.forEach(b => b.classList.remove("is-active"));
      const activeBtn = controls.querySelector(`[data-view="${view}"]`);
      activeBtn?.classList.add("is-active");
      activeBtn?.setAttribute("aria-pressed", "true");
      buttons.forEach(b => {
        if (b !== activeBtn) b.setAttribute("aria-pressed", "false");
      });

      container?.classList.remove("comparison-mode");

      if (view === "translated") {
        if (translated) translated.hidden = false;
        if (original) original.hidden = true;
      } else if (view === "original") {
        if (translated) translated.hidden = true;
        if (original) original.hidden = false;
      } else {
        if (translated) translated.hidden = false;
        if (original) original.hidden = false;
        container?.classList.add("comparison-mode");
      }

      try {
        sessionStorage.setItem("translation-view-mode", view);
      } catch (e) {
        /* storage unavailable */
      }
    }

    buttons.forEach(btn => {
      btn.addEventListener("click", () => switchView(btn.dataset.view ?? ""));
    });

    try {
      const saved = sessionStorage.getItem("translation-view-mode");
      if (saved && saved !== "translated") switchView(saved);
    } catch (e) {
      /* keep default */
    }
  }
  initTranslationToggle();
</script>
