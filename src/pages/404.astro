---
import { SITE } from "@config";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
---

<Layout title={`404 Not Found | ${SITE.title}`}>
  <Header />

  <main id="main-content">
    <section class="hero">
      <p class="eyebrow">错误 / 404</p>
      <div class="hero__grid">
        <h1 class="hero__title nf-code">404</h1>
        <div class="hero__copy">
          <p>这个地址没有对应的文档。它可能改过路径，也可能从未存在过。</p>
          <nav class="hero__links" aria-label="返回导航">
            <a href="/">回到首页 <span aria-hidden="true">↗</span></a>
            <a href="/posts/">浏览完整归档 <span aria-hidden="true">↗</span></a
            >
            <a href="/search/">搜索文章 <span aria-hidden="true">↗</span></a>
          </nav>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  main {
    width: 100%;
  }

  .nf-code {
    color: var(--accent);
  }
</style>
