---
import Layout from "@layouts/Layout.astro";
import PortfolioExperience, {
  type PortfolioData,
} from "@components/portfolio/PortfolioExperience";
import resume from "../data/portfolio.resume.json";
---

<Layout
  title="Rowan Liu · Portfolio"
  description="Frontend-leaning full-stack engineer portfolio for Rowan Liu: Angular, Node.js BFF, enterprise systems and AI-assisted delivery."
  scrollSmooth={true}
>
  <PortfolioExperience client:load data={resume as PortfolioData} />
</Layout>

<style is:global>
  /* Portfolio page: override the blog's global section constraints */
  .portfolio-page section,
  .portfolio-page footer {
    max-width: none;
    margin-inline: 0;
    padding-inline: 0;
  }
</style>
