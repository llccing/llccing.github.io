---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Card from "@components/Card.astro";
import SectionHeader from "@components/SectionHeader.astro";
import getSortedPosts from "@utils/getSortedPosts";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts
  .filter(({ data }) => !data.featured)
  .slice(0, 5);

const tagCount = new Set(sortedPosts.flatMap(({ data }) => data.tags)).size;
const yearsArr = sortedPosts.map(({ data }) =>
  new Date(data.pubDatetime).getFullYear()
);
const span =
  yearsArr.length > 0
    ? `${Math.min(...yearsArr)}–${Math.max(...yearsArr)}`
    : "—";

const stats = [
  {
    label: "存档篇数",
    value: String(sortedPosts.length).padStart(3, "0"),
    accent: true,
  },
  { label: "标签", value: String(tagCount).padStart(2, "0") },
  { label: "跨度", value: span },
  { label: "订阅", value: "RSS" },
];
---

<Layout
  title="Rowan Liu · Writing, systems and experiments"
  description="Notes on software, AI, research and the systems Rowan Liu builds around them."
>
  <Header />

  <main id="main-content">
    <section class="hero" aria-labelledby="home-title">
      <p class="eyebrow">写作 / 系统 / 实验</p>
      <div class="hero__grid">
        <h1 id="home-title" class="hero__title">
          写给那些必须真正跑起来的东西。
        </h1>
        <div class="hero__copy">
          <p>
            关于软件、AI
            与产品落地过程中的取舍。档案尽量贴着真实工作：交付了什么、改动了什么、当一个想法撞上现实时发生了什么。
          </p>
          <nav class="hero__links" aria-label="首页主导航">
            <a href="/posts/">进入完整归档 <span aria-hidden="true">↗</span></a
            >
            <a href="/projects/">查看项目 <span aria-hidden="true">↗</span></a>
            <a href="/rss.xml">订阅 RSS <span aria-hidden="true">↗</span></a>
          </nav>
        </div>
      </div>

      <dl class="stat-row">
        {
          stats.map(s => (
            <div class:list={["stat", { "stat--accent": s.accent }]}>
              <dt class="stat__label">{s.label}</dt>
              <dd class="stat__value">{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    {
      featuredPosts.length > 0 && (
        <section class="block-section" aria-labelledby="featured-title">
          <SectionHeader
            id="featured-title"
            eyebrow="重点"
            title="精选文章"
            count={featuredPosts.length}
          />
          <ul class="post-list">
            {featuredPosts.map(({ data, slug }) => (
              <Card
                href={`/posts/${slug}/`}
                frontmatter={data}
                headingLevel={3}
                featured={true}
              />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section class="block-section" aria-labelledby="recent-title">
          <SectionHeader
            id="recent-title"
            eyebrow="最近"
            title="最新记录"
            count={recentPosts.length}
            action={{ href: "/posts/", label: "浏览完整归档" }}
          />
          <ul class="post-list">
            {recentPosts.map(({ data, slug }) => (
              <Card
                href={`/posts/${slug}/`}
                frontmatter={data}
                headingLevel={3}
              />
            ))}
          </ul>
        </section>
      )
    }

    <section class="block-section" aria-labelledby="work-title">
      <SectionHeader id="work-title" eyebrow="作品" title="笔记背后的项目" />
      <div class="work-grid">
        <p>
          产品、开发者工具与实验，包含那些没能走下去的版本。每个案例都记录了最初的问题、实现方式，以及它现在停在哪里。
        </p>
        <a class="btn btn-solid" href="/projects/">
          查看项目 <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .work-grid {
    display: grid;
    gap: 1.5rem;
    align-items: start;
    padding: 2rem 0 0;
  }

  .work-grid p {
    max-width: 42em;
    margin: 0;
    color: var(--muted);
    font-size: var(--step-body);
    line-height: 1.75;
  }

  .work-grid .btn {
    justify-self: start;
  }

  @media (min-width: 768px) {
    .work-grid {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 3rem;
    }
  }
</style>
