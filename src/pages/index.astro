---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Card from "@components/Card";
import getSortedPosts from "@utils/getSortedPosts";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts
  .filter(({ data }) => !data.featured)
  .slice(0, 4);
---

<Layout
  title="Rowan Liu · Writing, systems and experiments"
  description="Notes on software, AI, research and the systems Rowan Liu builds around them."
>
  <Header />
  <main id="main-content" class="home-page">
    <section class="home-intro">
      <p class="eyebrow">Writing / systems / experiments</p>
      <div class="intro-grid">
        <h1>Notes from building things that have to work.</h1>
        <div class="intro-copy">
          <p>
            I write about software, AI and the practical decisions behind
            products in progress. The archive stays close to the work: what
            shipped, what changed and what I learned when an idea met reality.
          </p>
          <nav aria-label="Primary home links">
            <a href="/projects/"
              >Explore projects <span aria-hidden="true">↗</span></a
            >
            <a href="/rss.xml"
              >Follow via RSS <span aria-hidden="true">↗</span></a
            >
          </nav>
        </div>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section class="writing-section" aria-labelledby="featured-title">
          <div class="section-heading">
            <h2 id="featured-title">Featured writing</h2>
            <span>{featuredPosts.length.toString().padStart(2, "0")}</span>
          </div>
          <ul class="post-list">
            {featuredPosts.map(({ data, slug }) => (
              <Card
                href={`/posts/${slug}/`}
                frontmatter={data}
                secHeading={false}
              />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section class="writing-section" aria-labelledby="recent-title">
          <div class="section-heading">
            <h2 id="recent-title">Latest notes</h2>
            <span>{recentPosts.length.toString().padStart(2, "0")}</span>
          </div>
          <ul class="post-list">
            {recentPosts.map(({ data, slug }) => (
              <Card
                href={`/posts/${slug}/`}
                frontmatter={data}
                secHeading={false}
              />
            ))}
          </ul>
          <a class="section-link" href="/posts/">
            Browse the full archive <span aria-hidden="true">↗</span>
          </a>
        </section>
      )
    }

    <section class="work-note" aria-labelledby="work-title">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2 id="work-title">The projects behind the notes.</h2>
      </div>
      <p>
        Products, developer tools and experiments, including the honest
        archives. Each case study records the question, the implementation and
        where the work stands now.
      </p>
      <a href="/projects/">View projects <span aria-hidden="true">↗</span></a>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .home-page {
    --editorial-line: rgb(var(--color-text-base) / 0.18);
    --editorial-muted: rgb(var(--color-text-base) / 0.68);
    padding-bottom: 4rem;
  }

  .home-intro,
  .writing-section,
  .work-note {
    max-width: 72rem;
    margin: 0 auto;
    padding-inline: 1rem;
  }

  .home-intro {
    padding-top: 3.75rem;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid var(--editorial-line);
  }

  .eyebrow {
    margin: 0;
    color: var(--editorial-muted);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .intro-grid {
    display: grid;
    gap: 2rem;
    margin-top: 1.25rem;
  }

  .intro-grid h1 {
    max-width: 16ch;
    margin: 0;
    font-size: clamp(2.5rem, 6.5vw, 4.75rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .intro-copy {
    align-self: end;
  }

  .intro-copy > p {
    max-width: 36rem;
    margin: 0;
    color: var(--editorial-muted);
    font-size: 1rem;
    line-height: 1.75;
  }

  .intro-copy nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .intro-copy a,
  .section-link,
  .work-note > a {
    border-bottom: 1px solid currentColor;
    color: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
  }

  .writing-section {
    padding-top: 4rem;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--editorial-line);
  }

  .section-heading h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
  }

  .section-heading span {
    color: var(--editorial-muted);
    font-size: 0.75rem;
  }

  .post-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .section-link {
    display: inline-block;
    margin-top: 2rem;
  }

  .work-note {
    display: grid;
    gap: 1.5rem;
    margin-top: 5rem;
    padding-top: 2.25rem;
    padding-bottom: 2.25rem;
    border-top: 1px solid var(--editorial-line);
    border-bottom: 1px solid var(--editorial-line);
  }

  .work-note h2 {
    max-width: 16ch;
    margin: 0.65rem 0 0;
    font-size: 1.75rem;
    line-height: 1.15;
  }

  .work-note > p {
    max-width: 40rem;
    margin: 0;
    color: var(--editorial-muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .work-note > a {
    width: max-content;
    align-self: end;
  }

  @media (min-width: 640px) {
    .home-intro,
    .writing-section,
    .work-note {
      padding-inline: 2rem;
    }

    .intro-grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
    }

    .work-note {
      grid-template-columns: minmax(14rem, 0.75fr) minmax(0, 1.1fr) auto;
      align-items: start;
    }
  }
</style>
