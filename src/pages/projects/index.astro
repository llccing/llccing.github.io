---
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Layout from "@layouts/Layout.astro";
import { projects } from "@data/projects";

const featured = projects.filter(project => project.featured);
const moreProjects = projects.filter(project => !project.featured);
---

<Layout
  title="Projects · Rowan Liu"
  description="Selected products, developer tools and experiments built by Rowan Liu."
>
  <Header activeNav="projects" />
  <main id="main-content" class="projects-page">
    <section class="projects-intro">
      <p class="eyebrow">Selected work / 2025–2026</p>
      <div class="intro-grid">
        <h1>Projects built to answer real questions.</h1>
        <p>
          Products, engineering systems and experiments. Active work sits beside
          honest archives: each project records what was built, why it mattered
          and where it stopped.
        </p>
      </div>
    </section>

    <section aria-labelledby="featured-title" class="project-section">
      <div class="section-heading">
        <h2 id="featured-title">Featured work</h2>
        <span>{featured.length.toString().padStart(2, "0")}</span>
      </div>
      <div class="featured-grid">
        {
          featured.map((project, index) => (
            <article class={`project-card accent-${project.accent}`}>
              <a href={`/projects/${project.slug}/`} aria-label={project.title}>
                <div class="card-topline">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <span class={`status status-${project.status}`}>
                    {project.statusLabel}
                  </span>
                </div>
                {project.image ? (
                  <div class="project-visual">
                    <img
                      src={project.image}
                      alt={project.imageAlt}
                      width="1440"
                      height="900"
                      loading={index === 0 ? "eager" : "lazy"}
                    />
                  </div>
                ) : (
                  <div class="project-mark" aria-hidden="true">
                    <span>{project.title.slice(0, 2).toUpperCase()}</span>
                  </div>
                )}
                <p class="kicker">{project.kicker}</p>
                <h3>{project.title}</h3>
                <p class="summary">{project.summary}</p>
                <ul class="tech-list" aria-label="Technologies">
                  {project.technologies.slice(0, 4).map(tech => (
                    <li>{tech}</li>
                  ))}
                </ul>
                <span class="case-link">
                  Read case study <span aria-hidden="true">↗</span>
                </span>
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section
      aria-labelledby="more-title"
      class="project-section compact-section"
    >
      <div class="section-heading">
        <h2 id="more-title">Explorations</h2>
        <span>{moreProjects.length.toString().padStart(2, "0")}</span>
      </div>
      <div class="project-list">
        {
          moreProjects.map(project => (
            <a class="project-row" href={`/projects/${project.slug}/`}>
              <div>
                <p class="kicker">{project.kicker}</p>
                <h3>{project.title}</h3>
              </div>
              <p>{project.summary}</p>
              <div class="row-meta">
                <span>{project.year}</span>
                <span aria-hidden="true">↗</span>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .projects-page {
    --project-line: rgb(var(--color-text-base) / 0.18);
    --project-muted: rgb(var(--color-text-base) / 0.68);
    padding-bottom: 4rem;
  }

  .projects-intro,
  .project-section {
    max-width: 72rem;
    margin: 0 auto;
    padding-inline: 1rem;
  }

  .projects-intro {
    padding-top: 4.5rem;
    padding-bottom: 5rem;
    border-bottom: 1px solid var(--project-line);
  }

  .eyebrow,
  .kicker {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--project-muted);
  }

  .intro-grid {
    display: grid;
    gap: 2rem;
    margin-top: 1.25rem;
  }

  .intro-grid h1 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .intro-grid > p {
    max-width: 35rem;
    margin: 0;
    align-self: end;
    color: var(--project-muted);
    font-size: 1rem;
    line-height: 1.75;
  }

  .project-section {
    padding-top: 4rem;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--project-line);
  }

  .section-heading h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
  }

  .section-heading span {
    color: var(--project-muted);
    font-size: 0.75rem;
  }

  .featured-grid {
    display: grid;
    gap: 1px;
    margin-top: 1px;
    background: var(--project-line);
    border: 1px solid var(--project-line);
  }

  .project-card {
    min-width: 0;
    background: rgb(var(--color-fill));
  }

  .project-card > a {
    position: relative;
    display: flex;
    min-height: 31rem;
    height: 100%;
    flex-direction: column;
    padding: 1.25rem;
    color: inherit;
    text-decoration: none;
  }

  .project-card > a::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--accent);
    content: "";
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 180ms ease;
  }

  .project-card > a:hover::before,
  .project-card > a:focus-visible::before {
    transform: scaleY(1);
  }

  .accent-cyan {
    --accent: #00a7b5;
  }
  .accent-green {
    --accent: #43a047;
  }
  .accent-red {
    --accent: #e5484d;
  }
  .accent-yellow {
    --accent: #d99a00;
  }
  .accent-blue {
    --accent: #3976d5;
  }

  .card-topline,
  .row-meta {
    display: flex;
    justify-content: space-between;
    color: var(--project-muted);
    font-size: 0.72rem;
  }

  .status {
    color: inherit;
  }

  .status::before {
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.45rem;
    border-radius: 999px;
    background: currentColor;
    content: "";
  }

  .status-active {
    color: #16833b;
  }
  .status-exploring {
    color: #9b6b00;
  }

  .project-mark {
    display: grid;
    width: 100%;
    aspect-ratio: 16 / 8;
    margin: 1.5rem 0 1.75rem;
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--project-line);
    background:
      linear-gradient(
        90deg,
        transparent 49.5%,
        rgb(var(--color-text-base) / 0.08) 50%,
        transparent 50.5%
      ),
      linear-gradient(
        0deg,
        transparent 49.5%,
        rgb(var(--color-text-base) / 0.08) 50%,
        transparent 50.5%
      );
  }

  .project-visual {
    width: 100%;
    aspect-ratio: 16 / 8;
    margin: 1.5rem 0 1.75rem;
    overflow: hidden;
    border: 1px solid var(--project-line);
    background: rgb(var(--color-card));
  }

  .project-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    filter: saturate(0.82) contrast(1.02);
    transition:
      transform 220ms ease,
      filter 220ms ease;
  }

  .project-card > a:hover .project-visual img,
  .project-card > a:focus-visible .project-visual img {
    transform: scale(1.025);
    filter: saturate(1) contrast(1.02);
  }

  .project-mark span {
    color: var(--accent);
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 700;
    line-height: 1;
  }

  .project-card h3,
  .project-row h3 {
    margin: 0.5rem 0 0;
    font-size: 1.5rem;
    line-height: 1.15;
  }

  .summary {
    margin: 1rem 0 1.5rem;
    color: var(--project-muted);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: auto 0 1.5rem;
    padding: 0;
    list-style: none;
  }

  .tech-list li {
    border: 1px solid var(--project-line);
    padding: 0.25rem 0.45rem;
    font-size: 0.68rem;
  }

  .case-link {
    display: flex;
    justify-content: space-between;
    padding-top: 0.9rem;
    border-top: 1px solid var(--project-line);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .compact-section {
    padding-bottom: 2rem;
  }

  .project-row {
    display: grid;
    gap: 1rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--project-line);
    color: inherit;
    text-decoration: none;
  }

  .project-row > p {
    margin: 0;
    color: var(--project-muted);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  @media (min-width: 640px) {
    .projects-intro,
    .project-section {
      padding-inline: 2rem;
    }

    .intro-grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
    }

    .featured-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .project-row {
      grid-template-columns: minmax(12rem, 0.7fr) minmax(0, 1.3fr) 6rem;
      align-items: center;
    }
  }

  @media (min-width: 980px) {
    .featured-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
