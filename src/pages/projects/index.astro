---
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Layout from "@layouts/Layout.astro";
import { projects } from "@data/projects";
import { selectedWork } from "@data/selectedWork";

const featured = projects.filter(project => project.featured);
const archived = projects.filter(project => !project.featured);
---

<Layout
  title="Projects · Rowan Liu"
  description="Enterprise systems, a long-running personal publishing product and an honest archive of experiments, built by Rowan Liu."
>
  <Header activeNav="projects" />
  <main id="main-content" class="projects-page">
    <section class="projects-intro">
      <p class="eyebrow">Selected work / 2016 — now</p>
      <div class="intro-grid">
        <h1>Projects built to answer real questions.</h1>
        <p>
          Enterprise systems delivered for past employers, one long-running
          personal product, and an archive of experiments that stopped. Each
          entry records what was built, why it mattered and where it ended.
        </p>
      </div>
    </section>

    <section aria-labelledby="work-title" class="project-section">
      <div class="section-heading">
        <h2 id="work-title">Enterprise systems</h2>
        <span>{selectedWork.length.toString().padStart(2, "0")}</span>
      </div>
      <p class="section-note">
        Shipped product and platform work for previous employers. My current
        role is covered on the portfolio page instead.
      </p>
      <div class="work-list">
        {
          selectedWork.map(item => (
            <article class="work-row">
              <h3>{item.name}</h3>
              <p class="work-meta">
                {item.role} · {item.company} · {item.period}
              </p>
              <p class="work-summary">{item.summary}</p>
              <p class="work-impact">{item.impact}</p>
              <ul class="work-tech" aria-label="Technologies">
                {item.technologies.map(tech => (
                  <li>{tech}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <a class="section-link" href="/portfolio/">
        Full career history on the portfolio page <span aria-hidden="true"
          >↗</span
        >
      </a>
    </section>

    <section aria-labelledby="personal-title" class="project-section">
      <div class="section-heading">
        <h2 id="personal-title">Personal work</h2>
        <span>{featured.length.toString().padStart(2, "0")}</span>
      </div>
      <div class="personal-list">
        {
          featured.map(project => (
            <article class="personal-card">
              <a href={`/projects/${project.slug}/`} aria-label={project.title}>
                {project.image ? (
                  <div class="personal-visual">
                    <img
                      src={project.image}
                      alt={project.imageAlt}
                      width="1440"
                      height="900"
                      loading="lazy"
                    />
                  </div>
                ) : null}
                <div class="personal-body">
                  <div class="card-topline">
                    <span class={`status status-${project.status}`}>
                      {project.statusLabel}
                    </span>
                    <span>{project.year}</span>
                  </div>
                  <p class="kicker">{project.kicker}</p>
                  <h3>{project.title}</h3>
                  <p class="summary">{project.summary}</p>
                  <ul class="work-tech" aria-label="Technologies">
                    {project.technologies.map(tech => (
                      <li>{tech}</li>
                    ))}
                  </ul>
                  <span class="case-link">
                    Read case study <span aria-hidden="true">↗</span>
                  </span>
                </div>
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section
      aria-labelledby="archive-title"
      class="project-section compact-section"
    >
      <details class="archive-block">
        <summary>
          <h2 id="archive-title">Archive</h2>
          <span
            >{archived.length.toString().padStart(2, "0")} · no longer developed</span
          >
        </summary>
        <div class="project-list">
          {
            archived.map(project => (
              <a class="project-row" href={`/projects/${project.slug}/`}>
                <div>
                  <span class={`status status-${project.status}`}>
                    {project.statusLabel}
                  </span>
                  <p class="kicker">{project.kicker}</p>
                  <h3>{project.title}</h3>
                </div>
                <p>{project.summary}</p>
                <div class="row-meta">
                  <span>{project.year}</span>
                  <span aria-hidden="true">↗</span>
                </div>
              </a>
            ))
          }
        </div>
      </details>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .projects-page {
    --project-line: var(--line);
    --project-muted: var(--muted);
    padding-bottom: 4rem;
  }

  .projects-intro,
  .project-section {
    max-width: var(--measure-wide);
    margin: 0 auto;
    padding-inline: var(--gutter);
  }

  .projects-intro {
    padding-top: 4.5rem;
    padding-bottom: 5rem;
    border-bottom: 1px solid var(--project-line);
  }

  .eyebrow,
  .kicker {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--project-muted);
  }

  .intro-grid {
    display: grid;
    gap: 2rem;
    margin-top: 1.25rem;
  }

  .intro-grid h1 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .intro-grid > p {
    max-width: 35rem;
    margin: 0;
    align-self: end;
    color: var(--project-muted);
    font-size: 1rem;
    line-height: 1.75;
  }

  .project-section {
    padding-top: 4rem;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--project-line);
  }

  .section-heading h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
  }

  .section-heading span {
    color: var(--project-muted);
    font-size: 0.75rem;
  }

  .section-note {
    max-width: 42rem;
    margin: 1rem 0 0;
    color: var(--project-muted);
    font-size: 0.82rem;
    line-height: 1.7;
  }

  .work-list {
    display: grid;
    gap: 1px;
    margin-top: 1.5rem;
    background: var(--project-line);
    border: 1px solid var(--project-line);
  }

  .work-row {
    background: rgb(var(--color-fill));
    padding: 1.5rem 1.25rem;
  }

  .work-row h3 {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.2;
  }

  .work-meta {
    margin: 0.4rem 0 0;
    color: var(--project-muted);
    font-size: 0.78rem;
  }

  .work-summary {
    margin: 0.9rem 0 0;
    color: var(--project-muted);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .work-impact {
    margin: 0.6rem 0 0;
    font-size: 0.85rem;
    line-height: 1.7;
  }

  .work-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .work-tech li {
    border: 1px solid var(--project-line);
    padding: 0.25rem 0.45rem;
    font-size: 0.68rem;
  }

  .section-link {
    display: inline-block;
    margin-top: 1.25rem;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid var(--project-line);
    color: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
  }

  .personal-list {
    margin-top: 1.5rem;
  }

  .personal-card > a {
    display: grid;
    gap: 1.5rem;
    padding: 1.25rem;
    border: 1px solid var(--project-line);
    border-left: 3px solid var(--accent);
    background: rgb(var(--color-fill));
    color: inherit;
    text-decoration: none;
  }

  .personal-visual {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--project-line);
    background: rgb(var(--color-card));
  }

  .personal-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    filter: saturate(0.82) contrast(1.02);
    transition:
      transform 220ms ease,
      filter 220ms ease;
  }

  .personal-card > a:hover .personal-visual img,
  .personal-card > a:focus-visible .personal-visual img {
    transform: scale(1.02);
    filter: saturate(1) contrast(1.02);
  }

  .card-topline,
  .row-meta {
    display: flex;
    justify-content: space-between;
    color: var(--project-muted);
    font-size: 0.72rem;
  }

  .status {
    display: inline-flex;
    align-items: center;
    color: inherit;
  }

  .status::before {
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.45rem;
    border-radius: 999px;
    background: currentColor;
    content: "";
  }

  .status-active {
    color: var(--accent);
  }

  .status-archived {
    color: var(--project-muted);
  }

  .personal-body h3,
  .project-row h3 {
    margin: 0.5rem 0 0;
    font-size: 1.5rem;
    line-height: 1.15;
  }

  .project-row h3 {
    font-size: 1.15rem;
  }

  .summary {
    margin: 1rem 0 1.5rem;
    color: var(--project-muted);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .case-link {
    display: flex;
    justify-content: space-between;
    padding-top: 0.9rem;
    border-top: 1px solid var(--project-line);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .archive-block {
    margin-top: 1.5rem;
  }

  .archive-block summary {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--project-line);
    cursor: pointer;
    list-style: none;
  }

  .archive-block summary::-webkit-details-marker {
    display: none;
  }

  .archive-block summary h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
  }

  .archive-block summary span {
    color: var(--project-muted);
    font-size: 0.75rem;
    text-align: right;
  }

  .archive-block summary span::after {
    content: " +";
    font-size: 0.85rem;
  }

  .archive-block[open] summary span::after {
    content: " \2212";
  }

  .archive-block[open] summary {
    border-bottom-color: transparent;
  }

  .compact-section {
    padding-bottom: 2rem;
  }

  .project-row {
    display: grid;
    gap: 1rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--project-line);
    color: inherit;
    text-decoration: none;
  }

  .project-row > p {
    margin: 0;
    color: var(--project-muted);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  @media (min-width: 640px) {
    .projects-intro,
    .project-section {
      padding-inline: var(--gutter);
    }

    .intro-grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
    }

    .project-row {
      grid-template-columns: minmax(12rem, 0.7fr) minmax(0, 1.3fr) 6rem;
      align-items: center;
    }
  }

  @media (min-width: 820px) {
    .personal-card > a {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2.5rem;
      align-items: center;
    }
  }
</style>
