---
import { type CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import MetaRow from "@components/MetaRow.astro";
import { SITE, DIGEST_DOMAIN_LABELS } from "@config";
import { getSortedDigests, digestDate, digestPath } from "@utils/getDigests";

export async function getStaticPaths() {
  const entries = await getSortedDigests();
  // Newest first, so index+1 is the previous (older) day.
  return entries.map((entry, index) => ({
    params: { slug: entry.slug },
    props: {
      entry,
      newer: entries[index - 1],
      older: entries[index + 1],
    },
  }));
}

interface Props {
  entry: CollectionEntry<"digest">;
  newer?: CollectionEntry<"digest">;
  older?: CollectionEntry<"digest">;
}

const { entry, newer, older } = Astro.props;
const { Content } = await entry.render();
const date = digestDate(entry);
---

<Layout
  title={`技术简报 ${date} | ${SITE.title}`}
  description={entry.data.description ??
    `${date} 技术动态，共 ${entry.data.itemCount} 条`}
>
  <Header activeNav="digest" />

  <div
    class="mx-auto w-full"
    style="max-width: var(--measure-wide); padding-inline: var(--gutter)"
  >
    <a class="doc-back" href="/digest/">
      <span aria-hidden="true">←</span> 返回简报
    </a>
  </div>

  <main id="main-content">
    <header class="doc-head">
      <p class="eyebrow doc-head__eyebrow">每日简报</p>
      <h1 class="doc-head__title">技术简报 {date}</h1>

      <div class="doc-head__meta">
        <MetaRow
          orientation="inline"
          items={[
            { label: "条目", value: `${entry.data.itemCount}` },
            { label: "生成", value: entry.data.generatedBy },
            {
              label: "校对",
              value: entry.data.reviewed ? "已人工校对" : "未人工校对",
            },
          ]}
        />
        <ul class="chip-row">
          {
            entry.data.domains.map(domain => (
              <li>
                <a class="chip" href={`/digest/domain/${domain}/`}>
                  {DIGEST_DOMAIN_LABELS[domain]}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </header>

    <article class="prose doc-body">
      <Content />
    </article>

    <nav class="doc-foot" aria-label="简报日期导航">
      {
        older ? (
          <a href={digestPath(older)} class="btn">
            <span aria-hidden="true">←</span> {digestDate(older)}
          </a>
        ) : (
          <span />
        )
      }
      {
        newer && (
          <a href={digestPath(newer)} class="btn">
            {digestDate(newer)} <span aria-hidden="true">→</span>
          </a>
        )
      }
    </nav>
  </main>

  <Footer />
</Layout>

<style>
  main {
    width: 100%;
    max-width: var(--measure-wide);
    margin: 0 auto;
    padding: 0 var(--gutter) 4rem;
  }

  .doc-head {
    padding: 2.5rem 0 2rem;
    border-bottom: 2px solid var(--ink);
  }

  .doc-head__eyebrow {
    color: var(--accent);
  }

  .doc-head__title {
    margin: 0.75rem 0 0;
    font-size: var(--step-h1);
    font-weight: 700;
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
  }

  .doc-head__meta {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .doc-body {
    max-width: var(--measure-post);
    padding-top: 2.5rem;
  }
  .doc-body :global(.prose),
  .doc-body.prose {
    max-width: none;
  }

  .doc-foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: var(--hairline);
  }
  .doc-foot .btn {
    text-decoration: none;
  }
</style>
