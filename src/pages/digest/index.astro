---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Main from "@layouts/Main.astro";
import DigestSourceList from "@components/DigestSourceList.astro";
import {
  getSortedDigests,
  digestDate,
  digestPath,
  withinDays,
  currentMonth,
  collectSources,
  sourcesByDomain,
  domainCounts,
  groupByMonth,
} from "@utils/getDigests";
import { SITE } from "@config";

const entries = await getSortedDigests();

const latest = entries.at(0);
const week = withinDays(entries, 7);
const month = currentMonth(entries);

const latestGroups = latest ? sourcesByDomain(latest.data.sources) : [];
const weekSources = collectSources(week);
const weekCounts = domainCounts(weekSources);
const monthSources = collectSources(month);
const archive = groupByMonth(entries);
---

<Layout
  title={`Digest | ${SITE.title}`}
  description="每日技术动态简报，按领域汇总并附原文链接。"
>
  <Header activeNav="digest" />
  <Main
    pageTitle="Digest"
    pageDesc="每日抓取四个领域的官方发布与技术博客，由模型归纳，所有引用均为原文链接。"
  >
    {
      entries.length === 0 ? (
        <p class="micro">
          还没有简报。运行 <code>pnpm digest</code> 生成第一条。
        </p>
      ) : (
        <>
          <section class="subsection">
            <div class="subhead">
              <h2>最新 · {digestDate(latest!)}</h2>
              <a class="subhead__action" href={digestPath(latest!)}>
                查看全文 →
              </a>
            </div>
            <p class="micro">
              {latest!.data.itemCount} 条 · 由 {latest!.data.generatedBy} 生成
            </p>
            {latestGroups.map(group => (
              <div class="domain-block">
                <div class="subhead">
                  <h3>
                    {group.label}
                    <span class="badge">{group.sources.length}</span>
                  </h3>
                </div>
                <DigestSourceList sources={group.sources} />
              </div>
            ))}
          </section>

          <section class="subsection">
            <div class="subhead">
              <h2>本周</h2>
            </div>
            <p class="micro">
              {week.length} 天 · {weekSources.length} 条引用
            </p>
            <ul class="chip-row">
              {weekCounts.map(({ domain, label, count }) => (
                <li>
                  <a
                    class={count === 0 ? "chip is-empty" : "chip"}
                    href={`/digest/domain/${domain}/`}
                  >
                    {label} <span class="badge">{count}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>

          <section class="subsection">
            <div class="subhead">
              <h2>本月</h2>
            </div>
            <p class="micro">
              {month.length} 天 · {monthSources.length} 条引用
            </p>
          </section>

          <section class="subsection">
            <div class="subhead">
              <h2>归档</h2>
            </div>
            {archive.map(({ month: label, entries: monthEntries }) => (
              <div class="archive-month">
                <div class="subhead">
                  <h3>{label}</h3>
                </div>
                <ul class="day-grid">
                  {monthEntries.map(entry => (
                    <li>
                      <a href={digestPath(entry)}>
                        {digestDate(entry).slice(8)}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </section>
        </>
      )
    }
  </Main>
  <Footer />
</Layout>

<style>
  .domain-block {
    margin-top: 1.75rem;
  }
  .archive-month {
    margin-top: 1.75rem;
  }
</style>
