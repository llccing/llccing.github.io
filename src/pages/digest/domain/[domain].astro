---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Main from "@layouts/Main.astro";
import DigestSourceList from "@components/DigestSourceList.astro";
import { SITE, DIGEST_DOMAINS, DIGEST_DOMAIN_LABELS } from "@config";
import type { DigestDomain } from "@config";
import {
  getSortedDigests,
  entriesForDomain,
  digestDate,
  digestPath,
} from "@utils/getDigests";

export async function getStaticPaths() {
  const entries = await getSortedDigests();
  // Every domain gets a page even with no entries yet, so navigation from a
  // digest badge never lands on a 404.
  return DIGEST_DOMAINS.map(domain => ({
    params: { domain },
    props: { domain, groups: entriesForDomain(entries, domain) },
  }));
}

interface Props {
  domain: DigestDomain;
  groups: ReturnType<typeof entriesForDomain>;
}

const { domain, groups } = Astro.props;
const label = DIGEST_DOMAIN_LABELS[domain];
const total = groups.reduce((sum, g) => sum + g.sources.length, 0);
---

<Layout
  title={`${label} 简报 | ${SITE.title}`}
  description={`${label} 领域的技术动态时间线，共 ${total} 条`}
>
  <Header activeNav="digest" />
  <Main
    pageTitle={`${label} · 简报时间线`}
    pageDesc={`按日期倒序，共 ${total} 条动态。`}
  >
    <ul class="chip-row domain-switch">
      {
        DIGEST_DOMAINS.map(d => (
          <li>
            <a
              href={`/digest/domain/${d}/`}
              class={d === domain ? "chip chip--on" : "chip"}
              aria-current={d === domain ? "page" : undefined}
            >
              {DIGEST_DOMAIN_LABELS[d]}
            </a>
          </li>
        ))
      }
    </ul>

    {
      groups.length === 0 ? (
        <p class="micro">该领域还没有收录动态。</p>
      ) : (
        groups.map(({ entry, sources }) => (
          <section class="day-block">
            <div class="subhead">
              <h2>
                <a href={digestPath(entry)} class="subhead__action">
                  {digestDate(entry)}
                </a>
              </h2>
              <span class="badge">{sources.length}</span>
            </div>
            <DigestSourceList sources={sources} />
          </section>
        ))
      )
    }

    <p class="back-line">
      <a href="/digest/" class="subhead__action">← 返回简报总览</a>
    </p>
  </Main>
  <Footer />
</Layout>

<style>
  .domain-switch {
    margin-top: 0;
    margin-bottom: 2.5rem;
  }

  .chip--on {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
  }
  .chip--on:hover {
    color: var(--accent-ink);
  }

  .day-block {
    margin-top: 2.5rem;
  }

  .back-line {
    margin: 3rem 0 0;
    padding-top: 1.5rem;
    border-top: var(--hairline);
  }
</style>
